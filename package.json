{
  "name": "bili-nexus",
  "version": "1.2.13 (beta)",
  "description": "Automate, Monitor, Control — Your All-in-One Bilibili Live Solution.",
  "author": "CnXiaozhiY",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cnxiaozhiy/bili-nexus.git"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node --enable-source-maps dist/app.js",
    "dev": "cross-env NODE_ENV=development tsup --watch --onSuccess \"node --enable-source-maps dist/app.js\"",
    "dev:test": "cross-env NODE_ENV=development tsup --watch --onSuccess \"node --enable-source-maps dist/test.js\" --entry.test=src/test/index.ts",
    "build": "tsup",
    "build:test": "tsup --entry.test=src/test/index.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "brotli": "^1.3.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "json-bigint": "^1.0.0",
    "log4js": "^6.9.1",
    "moment": "^2.30.1",
    "mysql2": "^3.23.0",
    "p-limit": "^3.1.0",
    "qrcode": "^1.5.4",
    "throttled-queue": "^3.0.0",
    "uuid": "^11.0.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/brotli": "^1.3.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.45.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  }
}

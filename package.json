{
  "name": "bili-nexus",
  "version": "1.2.15 (beta)",
  "private": true,
  "description": "Automate, Monitor, Control — Your All-in-One Bilibili Live Solution.",
  "author": "CnXiaozhiY",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cnxiaozhiy/bili-nexus.git"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node --enable-source-maps dist/app.js",
    "dev": "cross-env NODE_ENV=development tsup --watch --onSuccess \"node --enable-source-maps dist/app.js\"",
    "build": "pnpm -r build && tsup",
    "type-check": "pnpm -r build && pnpm -r type-check && tsc --noEmit"
  },
  "dependencies": {
    "@bili-nexus/core": "workspace:*",
    "@bili-nexus/qq-bot": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "cross-env": "^7.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  }
}
